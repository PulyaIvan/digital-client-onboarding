@startuml Онбординг клиента (happy path, database-per-service)
title Онбординг клиента — happy path (микросервисная архитектура)
scale 2

actor Client as cl
participant "Onboarding\nService" as svc
database "Onboarding DB\n(Applicant, Application,\nApplicant_documents, Applicant_sensitive_data,\nKYC_Result)" as db_svc
participant "KYC\n(внешний)" as kyc
queue "Kafka" as bm
participant "Core Banking" as bk
database "Core Banking DB\n(Debit_account)" as db_bk
participant "Notification\nService" as ns
database "Notification DB\n(Notification)" as db_ns

cl -> svc: POST /application\n(данные заявки)
activate svc
svc -> svc: валидация полей
svc -> db_svc: сохранить заявку (status=CREATED)\n[Applicant, Applicant_sensitive_data (encrypted),\nApplicant_documents (storage_ref)]
svc ->> bm: publish event "VERIFY_REQUESTED"\n{applicationId, базовые данные анкеты, document refs}
svc -> db_svc: UPDATE Application (status=PENDING)
svc -> db_svc: INSERT Application_access_token\n(access_token_hash, issued_at)
svc --> cl: 202 Accepted\nstatus=PENDING, accessToken=<token>
deactivate svc

bm ->> kyc: consume "VERIFY_REQUESTED"\n{applicationId, базовые данные анкеты, document refs}
activate kyc
kyc -> svc: GET /internal/kyc-data/{applicationId}\nKycServiceAuth
activate svc
svc -> db_svc: SELECT Applicant_sensitive_data\nWHERE applicant_id = ?
svc --> kyc: паспорт, СНИЛС, ИНН, адреса\n(расшифрованные)
deactivate svc
note over kyc, svc
  Паспортные данные/СНИЛС/ИНН не летят в самом событии —
  отдельный узкий запрос, а не вещание в общую шину. См. ADR-008
end note
kyc -> kyc: проверка личности,\nоценка риска
kyc -> bm: publish event "VERIFICATION_COMPLETED"\n{applicationId, verdict=approved}
deactivate kyc

bm ->> svc: consume "VERIFICATION_COMPLETED"
activate svc
svc -> db_svc: INSERT KYC_Result (verdict, reason_code, ...)
svc -> db_svc: UPDATE Application status=APPROVED
svc -> bm: publish event "APPROVED"\n{applicationId}
deactivate svc

bm ->> bk: consume "APPROVED"\n{applicationId}
activate bk
bk -> db_bk: INSERT Debit_account (status=ACTIVE)\nидемпотентно по applicationId
bk ->> bm: publish event "ACCOUNT_CREATED"\n{applicationId}
deactivate bk

bm ->> svc: consume "ACCOUNT_CREATED"
activate svc
svc -> db_svc: UPDATE Application status=COMPLETED
deactivate svc

bm ->> ns: consume "ACCOUNT_CREATED"
activate ns
ns -> db_ns: INSERT Notification (status=PENDING)
ns -> ns: отправка push/email/sms
ns -> db_ns: UPDATE Notification status=SENT
deactivate ns

@enduml