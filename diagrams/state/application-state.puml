@startuml
[*] --> CREATED
CREATED --> KYC_PENDING : валидация пройдена
KYC_PENDING --> KYC_APPROVED : KYC approved
KYC_PENDING --> KYC_REJECTED : KYC rejected
KYC_PENDING --> MANUAL_REVIEW : KYC manual_review
KYC_APPROVED --> COMPLETED : счёт создан в Core Banking
MANUAL_REVIEW --> COMPLETED : менеджер одобрил
MANUAL_REVIEW --> KYC_REJECTED : менеджер отклонил
COMPLETED --> [*]
KYC_REJECTED --> [*]
@enduml
